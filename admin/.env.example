# Zebella CMS (Vite). All VITE_* values are PUBLIC and end up in the browser bundle.
# Use the SAME Firebase web app config as the storefront.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Origin of the deployed storefront whose /api/admin/* endpoints perform privileged actions.
VITE_STOREFRONT_URL=http://localhost:3000

# Image/video hosting on the free Cloudinary plan (used instead of Firebase Storage when both are set)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
