# ============================================================================
# Zebella Designs — storefront (Next.js) environment
# Copy to web/.env.local and fill in. NEVER commit .env.local.
#
# PUBLIC  = NEXT_PUBLIC_* : inlined into the browser bundle. Not secrets.
# SERVER  = everything else: only ever read in server code. Treat as secret.
# ============================================================================

# ---- PUBLIC: Firebase Web SDK config (Firebase console > Project settings > Your apps > Web) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: reCAPTCHA v3 site key to enable Firebase App Check in the browser
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# ---- PUBLIC: canonical site URL (used for SEO, sitemap, structured data) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- SERVER: Firebase Admin SDK service account (Project settings > Service accounts > Generate key) ----
# Paste the private key on ONE line with literal \n sequences, wrapped in double quotes.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ---- SERVER: Razorpay (Dashboard > Account & Settings > API keys). Use rzp_test_* keys until you go live. ----
# The mode (test/live) is inferred from the key prefix and shown to customers at checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose when creating the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=

# ---- SERVER: transactional email (Resend REST API). Leave blank to disable; the app will log and skip. ----
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# ---- SERVER: first-admin provisioning. >= 16 random chars. Remove (or rotate) after the first admin exists. ----
ADMIN_BOOTSTRAP_SECRET=

# ---- SERVER: comma-separated origins of the CMS app allowed to call /api/admin/* (CORS allow-list) ----
ADMIN_APP_ORIGIN=http://localhost:5174

# ---- SERVER: bearer token for the scheduled cleanup endpoint /api/cron/release-reservations ----
CRON_SECRET=

# ---- SERVER (development only): allow seeded DEMO products to be bought, TEST mode only ----
# Ignored (and purchases refused) whenever a live Razorpay key is configured.
ALLOW_DEMO_PURCHASES=false
