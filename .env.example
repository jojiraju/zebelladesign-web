# ============================================================================
# Zebella Designs — storefront (Next.js) environment
# Copy to .env.local and fill in. NEVER commit .env.local.
# ============================================================================

# Base URL of the Python backend API (no trailing slash), e.g. https://api.example.com/v1
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical site URL (used for SEO, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development only: allow seeded DEMO products to be bought (backend must also permit it)
ALLOW_DEMO_PURCHASES=false

# ---- DEV TOOL: AI image generation (npm run images). Never commit the key. ----
OPENAI_API_KEY=
# IMAGE_MODEL=gpt-image-1
# IMAGE_QUALITY=medium

# Demo mode: sample data is used when NEXT_PUBLIC_API_URL is empty. Set to false to disable it.
# NEXT_PUBLIC_USE_MOCK=false
